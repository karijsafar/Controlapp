# Copia este archivo como .env y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API) y tu clave de Anthropic (console.anthropic.com).

# Navegador (se incrustan al compilar; son claves públicas)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Servidor
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # secreta: nunca la subas a GitHub
ANTHROPIC_API_KEY=sk-ant-...              # secreta: nunca la subas a GitHub
